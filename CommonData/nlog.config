<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <!-- CorrelationId: short Guid for tracing a request through the stack -->
  <variable name="correlationLayout"
            value="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} | ${level:uppercase=true:padding=5} | ${logger:shortName=true} | ${message} ${exception:format=ToString}" />

  <targets>
    <target name="console"
            xsi:type="Console"
            layout="${correlationLayout}"
            encoding="utf-8" />

    <target name="file"
            xsi:type="File"
            fileName="logs/erp-dal-${date:format=yyyy-MM-dd}.log"
            layout="${correlationLayout}"
            encoding="utf-8"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            keepFileOpen="false" />
  </targets>

  <rules>
    <!-- DAO operations at Debug level -->
    <logger name="CommonData.DAO.*" minlevel="Debug" writeTo="console,file" final="true" />

    <!-- NHibernate internals at Warn (suppress verbose SQL unless ShowSql is on) -->
    <logger name="NHibernate.*" minlevel="Warn" writeTo="console,file" final="true" />

    <!-- Default: Info and above -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
