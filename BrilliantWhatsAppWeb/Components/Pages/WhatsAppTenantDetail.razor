@page "/whatsapp-tenants/new"
@page "/whatsapp-tenants/{TenantId:guid}"
@using WhatsAppData.VO
@using WhatsAppData.VO.WhatsApp
@using WhatsAppBusiness
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavManager
@rendermode InteractiveServer

<PageTitle>@(TenantId == Guid.Empty ? "New WhatsApp Tenant" : "Edit WhatsApp Tenant")</PageTitle>

<div class="page-container">
    <!-- Header -->
    <div class="page-header luxury-gradient">
        <div class="hero-brand">
            <img class="brand-logo" src="images/brand/logo.png" alt="Brilliant logo" />
            <span class="wa-logo-badge" title="WhatsApp">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </span>
            <div>
                <h1 class="page-title">@(TenantId == Guid.Empty ? "Create New WhatsApp Tenant" : "Edit WhatsApp Tenant")</h1>
                <p class="page-subtitle">Manage WhatsApp business account integration</p>
            </div>
        </div>
    </div>
    @if (currentVO != null)
    {
        <div class="audit-info" style="margin-bottom:1rem;color:var(--text-muted);">
            <small>Created: @currentVO.CreatedAt.ToLocalTime()</small>
            @if (currentVO.UpdatedAt.HasValue)
            {
                <span style="margin-left:1rem;">Last Modified: @currentVO.UpdatedAt.Value.ToLocalTime()</span>
            }
        </div>
    }

    <!-- Form Card -->
    <div class="form-card">
        <EditForm Model="formData" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <!-- Tenant Section -->
            <div class="form-section">
                <h3 class="section-title">Tenant Information</h3>
                <div class="form-group">
                    <label>Tenant Name *</label>
                    <InputText @bind-Value="formData.TenantName" class="form-control" placeholder="Enter tenant name" />
                    <ValidationMessage For="@(() => formData.TenantName)" />
                </div>
            </div>

            <!-- Contact Section -->
            <div class="form-section">
                <h3 class="section-title">Contact Information</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label>Contact Name *</label>
                        <InputText @bind-Value="formData.ContactName" class="form-control" placeholder="Enter contact name" />
                        <ValidationMessage For="@(() => formData.ContactName)" />
                    </div>
                    <div class="form-group">
                        <label>Contact Phone *</label>
                        <InputText @bind-Value="formData.ContactPhone" class="form-control" placeholder="Enter phone number" />
                        <ValidationMessage For="@(() => formData.ContactPhone)" />
                    </div>
                </div>
            </div>

            <!-- WhatsApp Business Section -->
            <div class="form-section">
                <h3 class="section-title">WhatsApp Business Account</h3>
                <div class="form-group">
                    <label>Business Account ID *</label>
                    <InputText @bind-Value="formData.WABusinessAccountId" class="form-control" placeholder="Enter WhatsApp Business Account ID" />
                    <ValidationMessage For="@(() => formData.WABusinessAccountId)" />
                </div>
                <div class="form-group">
                    <label>Access Token *</label>
                    <div class="token-input-group">
                        <InputText @bind-Value="formData.WAAccessToken" class="form-control" type="@(showToken ? "text" : "password")" placeholder="Enter WhatsApp Access Token" />
                        <button type="button" class="btn btn-secondary token-toggle" @onclick="ToggleTokenVisibility" title="@(showToken ? "Hide token" : "Show token")">
                            @(showToken ? "Hide" : "Show")
                        </button>
                    </div>
                    <ValidationMessage For="@(() => formData.WAAccessToken)" />
                </div>
                <div class="form-group">
                    <label>Phone Number ID *</label>
                    <InputText @bind-Value="formData.WAPhoneNumberId" class="form-control" placeholder="Enter Phone Number ID" />
                    <ValidationMessage For="@(() => formData.WAPhoneNumberId)" />
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    @(TenantId == Guid.Empty ? "Create Tenant" : "Save Changes")
                </button>
                <button type="button" class="btn btn-secondary" @onclick="GoBack">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>

<!-- Notification Toast -->
@if (!string.IsNullOrEmpty(notificationMessage))
{
    <div class="toast @notificationClass">
        @notificationMessage
    </div>
}

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    private WhatsAppTenantFormData formData = new();
    private WhatsAppTenantBE whatsAppTenantBE = new();
    private WhatsAppTenantVO? currentVO;
    private bool showToken = false;
    private string notificationMessage = "";
    private string notificationClass = "";

    protected override async Task OnInitializedAsync()
    {
        if (TenantId != Guid.Empty)
        {
            currentVO = await whatsAppTenantBE.GetWhatsAppTenantById(TenantId);
            if (currentVO != null)
            {
                formData.TenantName = currentVO.Tenant?.Name ?? "";
                formData.ContactName = currentVO.Contact?.Name ?? "";
                formData.ContactPhone = currentVO.Contact?.Phone ?? "";
                formData.WABusinessAccountId = currentVO.WhatsAppCredentials.WABusinessAccountId ?? "";
                formData.WAAccessToken = currentVO.WhatsAppCredentials.WAAccessToken ?? "";
                formData.WAPhoneNumberId = currentVO.Contact.PhoneNumberId ?? "";
            }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (TenantId == Guid.Empty)
            {
                var vo = new WhatsAppTenantVO
                {
                    Id = Guid.NewGuid(),
                    WhatsAppCredentials = new WhatsAppCredentialsVO()
                    {
                        WABusinessAccountId = formData.WABusinessAccountId ,
                        WAAccessToken = formData.WAAccessToken
                    } ,

                    Tenant = new CommonData.VO.TenantVO { Name = formData.TenantName, Active = true },
                    Contact = new ContactVO { 
                        Name = formData.ContactName,
                        Phone = formData.ContactPhone,
                        PhoneNumberId = formData.WAPhoneNumberId
                    }
                };

                await whatsAppTenantBE.CreateNewTenet(vo);
            }
            else
            {
                if (currentVO != null)
                {
                    currentVO.WhatsAppCredentials.WABusinessAccountId = formData.WABusinessAccountId;
                    currentVO.WhatsAppCredentials.WAAccessToken = formData.WAAccessToken;
                    
                    currentVO.Tenant ??= new CommonData.VO.TenantVO();
                    currentVO.Tenant.Name = formData.TenantName;
                    
                    currentVO.Contact ??= new WhatsAppData.VO.WhatsApp.ContactVO();
                    currentVO.Contact.Name = formData.ContactName;
                    currentVO.Contact.Phone = formData.ContactPhone;
                    currentVO.Contact.PhoneNumberId = formData.WAPhoneNumberId;

                    await whatsAppTenantBE.SaveOrUpdateTenet(currentVO);
                }
            }

            NavManager.NavigateTo("/whatsapp-tenants");
        }
        catch (Exception ex)
        {
            ShowNotification($"Error saving tenant: {ex.Message}", "error");
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/whatsapp-tenants");
    }

    private void ToggleTokenVisibility() => showToken = !showToken;

    private void ShowNotification(string message, string type)
    {
        notificationMessage = message;
        notificationClass = type == "error" ? "toast-error" : "toast-success";
        StateHasChanged();

        Task.Delay(4000).ContinueWith(_ =>
        {
            notificationMessage = "";
            InvokeAsync(StateHasChanged);
        });
    }

    public class WhatsAppTenantFormData
    {
        [Required]
        public string TenantName { get; set; } = "";

        [Required]
        public string ContactName { get; set; } = "";

        [Required]
        public string ContactPhone { get; set; } = "";

        [Required]
        public string WABusinessAccountId { get; set; } = "";

        [Required]
        public string WAAccessToken { get; set; } = "";

        [Required]
        public string WAPhoneNumberId { get; set; } = "";
    }
}
