@page "/whatsapp-tenants"
@using WhatsAppData.VO
@using WhatsAppData.VO.WhatsApp
@using WhatsAppBusiness
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager NavManager
@rendermode InteractiveServer

<PageTitle>WhatsApp Tenants</PageTitle>

<div class="page-container">
    <!-- Premium Header -->
    <div class="page-header luxury-gradient">
        <div class="header-content">
            <h1 class="page-title">
                <span class="wa-logo-badge" title="WhatsApp">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                </span> WhatsApp Tenants
            </h1>
            <p class="page-subtitle">Manage your WhatsApp business accounts and integrations</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-secondary" @onclick="DisableSelected" disabled="@(selectedIds.Count == 0)">
                Disable Selected @(selectedIds.Count > 0 ? $"({selectedIds.Count})" : "")
            </button>
            <button class="btn btn-primary btn-lg" @onclick="() => NavigateToCreate()">
                <svg class="icon-svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4Z"/></svg>
                New Tenant
            </button>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="search-bar">
        <div class="search-input-group">
            <input type="text" 
                   placeholder="Search by tenant name, contact, or phone..." 
                   value="@searchQuery" 
                   @oninput="OnSearchInput"
                   class="form-control search-input" />
            <span class="search-icon">
                <svg class="icon-svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
            </span>
        </div>
        <div class="filter-group">
            <select value="@selectedStatus" @onchange="OnStatusFilterChange" class="form-control filter-select">
                <option value="0">All Tenants</option>
                <option value="1">Active</option>
                <option value="2">Inactive</option>
            </select>
            <label class="select-all">
                <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                Select all on page
            </label>
        </div>
    </div>

    <!-- Status Cards -->
    <div class="status-cards">
        <div class="card status-card active">
            <div class="card-icon">✓</div>
            <div class="card-content">
                <p class="card-label">Active Tenants</p>
                <p class="card-value">@activeTenantCount</p>
            </div>
        </div>
        <div class="card status-card inactive">
            <div class="card-icon">○</div>
            <div class="card-content">
                <p class="card-label">Disabled Tenants</p>
                <p class="card-value">@inactiveTenantCount</p>
            </div>
        </div>
        <div class="card status-card total">
            <div class="card-icon">≡</div>
            <div class="card-content">
                <p class="card-label">Total Tenants</p>
                <p class="card-value">@totalTenantCount</p>
            </div>
        </div>
    </div>

    <!-- Tenant List -->
    <div class="tenant-list">
        @if (tenants == null)
        {
            <div class="loading-spinner">Loading tenants...</div>
        }
        else if (!tenants.Any())
        {
            <div class="empty-state">
                <svg class="empty-icon-svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4H4.98zm-1.17-.437A1.5 1.5 0 0 1 4.98 3h6.04a1.5 1.5 0 0 1 1.17.563l3.7 4.625a.5.5 0 0 1 .106.374l-.39 3.124A1.5 1.5 0 0 1 14.117 13H1.883a1.5 1.5 0 0 1-1.489-1.314l-.39-3.124a.5.5 0 0 1 .106-.374l3.7-4.625z"/></svg>
                <p class="empty-text">No tenants found</p>
            </div>
        }
        else
        {
            @foreach (var tenant in pagedTenants)
            {
                <div class="tenant-card">
                    <div class="card-header">
                        <div class="tenant-select">
                            <input type="checkbox" checked="@selectedIds.Contains(tenant.Id)" @onchange="(e) => OnSelectTenant(e, tenant.Id)" />
                        </div>
                        <div class="tenant-info">
                            <h3 class="tenant-name">@tenant.Tenant?.Name</h3>
                            <p class="contact-name">
                                <svg class="icon-svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/></svg>
                                @tenant.Contact?.Name
                            </p>
                        </div>
                        <div class="status-badge @(tenant.Tenant?.Active == true ? "active" : "inactive")">
                            @(tenant.Tenant?.Active == true ? "Active" : "Inactive")
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="account-id">
                            <span class="label">Business Account:</span>
                            <span class="value">@tenant.WhatsAppCredentials.WABusinessAccountId</span>
                        </p>
                        <p class="phone-id">
                            <span class="label">Phone ID:</span>
                            <span class="value">@tenant.Contact.PhoneNumberId</span>
                        </p>
                    </div>
                    <div class="card-actions">
                        <button class="btn-action edit" @onclick="() => NavigateToEdit(tenant.Id)" title="Edit">
                            <svg class="icon-svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.761 5.175L6 10h.5a.5.5 0 0 1 .5.5v.5H7v.5h.5a.5.5 0 0 1 .5.5v.5h.207l.825-.825-1.414-1.414-.68.68z"/></svg>
                            Edit
                        </button>
                        @if (tenant.Tenant?.Active == true)
                        {
                            <button class="btn-action disable" @onclick="() => ShowDisableModal(tenant.Id)" title="Disable">
                                <svg class="icon-svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/></svg>
                                Disable
                            </button>
                        }
                        else
                        {
                            <button class="btn-action enable" @onclick="() => EnableTenant(tenant.Id)" title="Enable">
                                <svg class="icon-svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
                                Enable
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>

    @if (TotalPages > 1)
    {
        <div class="pagination">
            <button class="btn btn-secondary" @onclick="PrevPage" disabled="@(pageNumber <= 1)">← Prev</button>
            <span class="page-info">Page @pageNumber of @TotalPages</span>
            <button class="btn btn-secondary" @onclick="NextPage" disabled="@(pageNumber >= TotalPages)">Next →</button>
        </div>
    }
</div>

<!-- Disable Confirmation Modal -->
@if (showDisableModal)
{
    <div class="modal-overlay" @onclick="CloseDisableModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Disable Tenant</h2>
                <button class="btn-close" @onclick="CloseDisableModal">×</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to disable this WhatsApp tenant? It will no longer be active but can be re-enabled later.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDisableModal">Cancel</button>
                <button class="btn btn-danger" @onclick="() => ConfirmDisableTenant(tenantToDisable)">Confirm Disable</button>
            </div>
        </div>
    </div>
}

<!-- Notification Toast -->
@if (!string.IsNullOrEmpty(notificationMessage))
{
    <div class="toast @notificationClass">
        @notificationMessage
    </div>
}

@code {
    private List<WhatsAppTenantVO>? tenants;
    private WhatsAppTenantBE whatsAppTenantBE = new();
    private string searchQuery = "";
    private int selectedStatus = 0; // 0 = All, 1 = Active, 2 = Inactive
    private int activeTenantCount = 0;
    private int inactiveTenantCount = 0;
    private int totalTenantCount = 0;
    private bool showDisableModal = false;
    private Guid tenantToDisable = Guid.Empty;
    private string notificationMessage = "";
    private string notificationClass = "";
    private int pageNumber = 1;
    private int pageSize = 10;
    private int filteredCount = 0;
    private List<WhatsAppTenantVO> pagedTenants = new();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filteredCount / pageSize));
    private bool IsAllSelected => pagedTenants.Count > 0 && pagedTenants.All(t => selectedIds.Contains(t.Id));

    protected override async Task OnInitializedAsync()
    {
        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        try
        {
            // Use BE to fetch all tenants (both active and inactive)
            tenants = (List<WhatsAppTenantVO>)(await whatsAppTenantBE.GetAllWhatsAppTenants());
            UpdateCounts();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            ShowNotification($"Error loading tenants: {ex.Message}", "error");
        }
    }

    private void UpdateCounts()
    {
        activeTenantCount = tenants?.Count(t => t.Tenant?.Active == true) ?? 0;
        inactiveTenantCount = tenants?.Count(t => t.Tenant?.Active == false) ?? 0;
        totalTenantCount = tenants?.Count ?? 0;
    }

    private void ApplyFilters()
    {
        if (tenants == null) return;

        var filtered = tenants.AsEnumerable();

        // Status filter
        if (selectedStatus == 1)
            filtered = filtered.Where(t => t.Tenant?.Active == true);
        else if (selectedStatus == 2)
            filtered = filtered.Where(t => t.Tenant?.Active == false);

        // Search filter
        if (!string.IsNullOrEmpty(searchQuery))
        {
            var query = searchQuery.ToLower();
            filtered = filtered.Where(t =>
                t.Tenant?.Name?.ToLower().Contains(query) == true ||
                t.Contact?.Name?.ToLower().Contains(query) == true ||
                t.Contact?.Phone?.ToLower().Contains(query) == true
            );
        }

        var filteredList = filtered.ToList();
        filteredCount = filteredList.Count;

        // Clamp the page number if the filters shrank the result set.
        var totalPages = Math.Max(1, (int)Math.Ceiling((double)filteredCount / pageSize));
        if (pageNumber > totalPages) pageNumber = totalPages;

        pagedTenants = filteredList.Skip((pageNumber - 1) * pageSize).Take(pageSize).ToList();
    }

    private void NextPage()
    {
        pageNumber++;
        ApplyFilters();
    }

    private void PrevPage()
    {
        if (pageNumber > 1) pageNumber--;
        ApplyFilters();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e?.Value?.ToString() ?? "";
        pageNumber = 1;
        ApplyFilters();
    }

    private void OnStatusFilterChange(ChangeEventArgs e)
    {
        selectedStatus = int.TryParse(e?.Value?.ToString(), out var value) ? value : 0;
        pageNumber = 1;
        ApplyFilters();
    }

    private void NavigateToCreate()
    {
        NavManager.NavigateTo("/whatsapp-tenants/new");
    }

    private void NavigateToEdit(Guid id)
    {
        NavManager.NavigateTo($"/whatsapp-tenants/{id}");
    }

    private void ShowDisableModal(Guid id)
    {
        tenantToDisable = id;
        showDisableModal = true;
    }

    private HashSet<Guid> selectedIds = new();

    private static bool IsChecked(ChangeEventArgs e) =>
        e?.Value is bool b
            ? b
            : string.Equals(e?.Value?.ToString(), "on", StringComparison.OrdinalIgnoreCase)
              || string.Equals(e?.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private void OnSelectTenant(ChangeEventArgs e, Guid id)
    {
        if (IsChecked(e)) selectedIds.Add(id);
        else selectedIds.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (IsChecked(e))
        {
            foreach (var t in pagedTenants) selectedIds.Add(t.Id);
        }
        else
        {
            foreach (var t in pagedTenants) selectedIds.Remove(t.Id);
        }
    }

    private async Task DisableSelected()
    {
        if (!selectedIds.Any()) return;
        try
        {
            foreach (var id in selectedIds.ToList())
            {
                await whatsAppTenantBE.SetWhatsAppTenantActive(id, false);
            }
            selectedIds.Clear();
            ShowNotification("Selected tenants disabled", "success");
            await LoadTenants();
        }
        catch (Exception ex)
        {
            ShowNotification($"Error disabling selected: {ex.Message}", "error");
        }
    }

    private void CloseDisableModal()
    {
        showDisableModal = false;
        tenantToDisable = Guid.Empty;
    }

    private async Task ConfirmDisableTenant(Guid id)
    {
        bool? previous = null;
        try
        {
            // optimistic UI: mark disabled locally first
            var local = tenants?.FirstOrDefault(t => t.Id == id);
            previous = local?.Tenant?.Active;
            if (local?.Tenant != null) local.Tenant.Active = false;
            StateHasChanged();

            await whatsAppTenantBE.SetWhatsAppTenantActive(id, false);
            ShowNotification("Tenant disabled successfully", "success");
            CloseDisableModal();
            await LoadTenants();
        }
        catch (Exception ex)
        {
            // rollback optimistic change
            var local = tenants?.FirstOrDefault(t => t.Id == id);
            if (local?.Tenant != null) local.Tenant.Active = previous ?? true;
            ShowNotification($"Error disabling tenant: {ex.Message}", "error");
        }
    }

    private async Task EnableTenant(Guid id)
    {

        bool? previous = null;
        try
        {
            // optimistic UI
            var local = tenants?.FirstOrDefault(t => t.Id == id);
            previous = local?.Tenant?.Active;
            if (local?.Tenant != null) local.Tenant.Active = true;
            StateHasChanged();

            await whatsAppTenantBE.SetWhatsAppTenantActive(id, true);
            ShowNotification("Tenant enabled successfully", "success");
            await LoadTenants();
        }
        catch (Exception ex)
        {
            var local = tenants?.FirstOrDefault(t => t.Id == id);
            if (local?.Tenant != null) local.Tenant.Active = previous ?? false;
            ShowNotification($"Error enabling tenant: {ex.Message}", "error");
        }
    }

    private void ShowNotification(string message, string type)
    {
        notificationMessage = message;
        notificationClass = type == "error" ? "toast-error" : "toast-success";
        StateHasChanged();

        Task.Delay(4000).ContinueWith(_ =>
        {
            notificationMessage = "";
            InvokeAsync(StateHasChanged);
        });
    }
}
